# Server
PORT=5000
NODE_ENV=development

# Database
# The database named in the URI path is the one that gets used. Atlas
# copy-paste strings often omit it ("...mongodb.net/?retryWrites=true"), in
# which case MongoDB uses a database called "test".
MONGO_URI=mongodb://127.0.0.1:27017/ecohabits

# Optional override, only for pointing an existing deployment at a different
# database. LEAVE IT UNSET unless you mean it - setting it makes the app ignore
# the database in MONGO_URI, which hides all the data already stored there.
# MONGO_DB_NAME=ecohabits

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - the frontend origin(s). Comma-separate to allow more than one.
# Any *.vercel.app preview domain is allowed automatically.
# e.g. CLIENT_URL=https://eco-habits.vercel.app,http://localhost:3000
CLIENT_URL=http://localhost:3000
