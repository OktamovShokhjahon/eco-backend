# Server
PORT=5000
NODE_ENV=development

# Database
# Include the database name in the path. Atlas copy-paste strings often omit it
# ("...mongodb.net/?retryWrites=true"), which lands your data in a db called
# "test" - MONGO_DB_NAME below is the fallback when the path is empty.
MONGO_URI=mongodb://127.0.0.1:27017/ecohabits
MONGO_DB_NAME=ecohabits

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# CORS - the frontend origin(s). Comma-separate to allow more than one.
# Any *.vercel.app preview domain is allowed automatically.
# e.g. CLIENT_URL=https://eco-habits.vercel.app,http://localhost:3000
CLIENT_URL=http://localhost:3000
